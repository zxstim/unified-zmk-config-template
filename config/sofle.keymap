/*
 * Sofle keymap (ZMK v0.3).
 *
 * The layout the keyboard had in ZMK Studio on 2026-09-26, which started from ZMK's stock Sofle keymap, with
 * two changes:
 *   - LOWER / RAISE also tell the Mac when they're held (for zmkaid, the on-screen layer overlay).
 *   - RAISE's Undo / Cut / Copy / Paste send ⌘Z / ⌘X / ⌘C / ⌘V (the PC editing keys do nothing on a Mac).
 *
 * After flashing, click "Restore Stock Settings" in ZMK Studio so this file is used instead of Studio's saved
 * copy of the old keymap.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Hold LOWER + RAISE together for ADJUST.
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    // Momentary LOWER / RAISE that also tap an unused key when the layer turns on and off, so zmkaid on the
    // Mac can show the right layer: F16 / F17 = LOWER on / off, F18 / F19 = RAISE on / off.
    // The layer turns on first, so typing is never delayed.
    macros {
        lower_sig: lower_sig {
            compatible = "zmk,behavior-macro";
            display-name = "Lower (zmkaid)";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings
                = <&macro_press &mo LOWER>
                , <&macro_tap &kp F16>
                , <&macro_pause_for_release>
                , <&macro_release &mo LOWER>
                , <&macro_tap &kp F17>
                ;
        };

        raise_sig: raise_sig {
            compatible = "zmk,behavior-macro";
            display-name = "Raise (zmkaid)";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings
                = <&macro_press &mo RAISE>
                , <&macro_tap &kp F18>
                , <&macro_pause_for_release>
                , <&macro_release &mo RAISE>
                , <&macro_tap &kp F19>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   =   |
// | CAPS  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
// |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// |  GUI  |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//               |SHIFT| ALT  | CTRL | LOWER|  SPACE |  | ENTER | RAISE| BKSPC | DEL   |  /   |
            bindings = <
&kp ESC   &kp N1 &kp N2    &kp N3   &kp N4    &kp N5                            &kp N6 &kp N7     &kp N8    &kp N9  &kp N0   &kp EQUAL
&kp CAPS  &kp Q  &kp W     &kp E    &kp R     &kp T                             &kp Y  &kp U      &kp I     &kp O   &kp P    &kp MINUS
&kp TAB   &kp A  &kp S     &kp D    &kp F     &kp G                             &kp H  &kp J      &kp K     &kp L   &kp SEMI &kp SQT
&kp LGUI  &kp Z  &kp X     &kp C    &kp V     &kp B      &kp C_MUTE &none       &kp N  &kp M      &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                 &kp LSHFT &kp LALT &kp LCTRL &lower_sig &kp SPACE  &kp RET     &raise_sig &kp BSPC &kp DEL &kp FSLH
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "lower";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   =   |
// |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
// |  TAB  |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
// |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
//               |     |      |      |      |        |  |       |      |       |       |      |
            bindings = <
&kp ESC   &kp N1    &kp N2    &kp N3   &kp N4   &kp N5                      &kp N6    &kp N7   &kp N8    &kp N9    &kp N0   &kp EQUAL
&kp F1    &kp F2    &kp F3    &kp F4   &kp F5   &kp F6                      &kp F7    &kp F8   &kp F9    &kp F10   &kp F11  &kp F12
&kp TAB   &kp EXCL  &kp AT    &kp HASH &kp DLLR &kp PRCNT                   &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR &kp PIPE
&trans    &kp EQUAL &kp MINUS &kp PLUS &kp LBRC &kp RBRC  &trans &trans     &kp LBKT  &kp RBKT &kp SEMI  &kp COLON &kp BSLH &trans
                    &trans    &trans   &trans   &trans    &trans &trans     &trans    &trans   &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "raise";
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
// |       | INS  | PSCR | MENU  |       |      |                | PGUP |      |   ↑   |      |   0   |       |
// |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |  ←   |   ↓   |  →   |  DEL  | BKSPC |
// |       | ⌘Z   | ⌘X   | ⌘C    | ⌘V    |      |      |  |      |      |      |       |      |       |       |
//                |      |       |       |      |      |  |      |      |      |       |      |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &trans    &trans    &trans   &trans    &trans  &trans
&trans     &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                        &kp PG_UP &trans    &kp UP   &trans    &kp N0  &trans
&trans     &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                      &kp PG_DN &kp LEFT  &kp DOWN &kp RIGHT &kp DEL &kp BSPC
&trans     &kp LG(Z)    &kp LG(X)    &kp LG(C)    &kp LG(V)    &trans        &trans  &trans  &trans    &trans    &trans   &trans    &trans  &trans
                        &trans       &trans       &trans       &trans        &trans  &trans  &trans    &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "adjust";
// ----------------------------------------------------------------------------------------------------------------------------
// | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |  W   |      |       |      |       |       |
// | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
// |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
// |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
//                    |         |         |         |         |         | |      |      |      |       |      |
// (The W was in ZMK Studio's copy of this layer, probably by accident; replace it with &none to remove it.)
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &kp W &none &none &none &none &none
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &none &none &none &none &none &none
&none             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &none                                   &none &none &none &none &none &none
&none             &none           &none           &none           &none           &none            &rgb_ug RGB_TOG &none  &none &none &none &none &none &none
                                  &none           &none           &none           &none            &none           &none  &none &none &none &none
            >;
        };
    };
};
